{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended"
    ],
    "prHourlyLimit": 10,
    "lockFileMaintenance": {
        "enabled": true,
        "schedule": [
            "at any time"
        ]
    },
    "packageRules": [
        {
            "matchDatasources": [
                "pypi"
            ],
            "minimumReleaseAge": "14 days"
        },
        {
            "description": "Disable Python version updates in .python-version",
            "matchManagers": [
                "pyenv"
            ],
            "matchDepNames": [
                "python"
            ],
            "enabled": false
        },
        {
            "description": "Disable Python image version updates but allow digest updates",
            "matchManagers": [
                "dockerfile"
            ],
            "matchDatasources": [
                "docker"
            ],
            "matchPackageNames": [
                "python"
            ],
            "matchUpdateTypes": [
                "major",
                "minor",
                "patch"
            ],
            "enabled": false
        }
    ]
}